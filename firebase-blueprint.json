{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile stored in users/{userId}",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["soldier", "commander"]
        },
        "unit": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "fullName", "role", "unit", "email", "createdAt"]
    },
    "AttendanceReport": {
      "title": "Attendance Report",
      "description": "Daily check-in status stored in attendance/{reportId}",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "userName": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["base", "home", "field", "sick", "course", "other"]
        },
        "location": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        },
        "verifiedBy": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reportId", "userId", "userName", "unit", "status", "location", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles for soldiers and commanders"
    },
    "attendance/{reportId}": {
      "schema": "AttendanceReport",
      "description": "Reports of soldier status, location, exact time and notes"
    }
  }
}
