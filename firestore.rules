rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return myUser().data.role;
    }

    function isCommander() {
      return signedIn() && myRole() == "commander";
    }

    match /users/{userId} {
  allow read: if true;

  allow create: if signedIn() && (
    request.auth.uid == userId || isCommander()
  );

  allow update, delete: if isCommander();
}
    match /settings/{docId} {
  allow read: if true;
  allow write: if isCommander();
}

    match /attendance/{reportId} {
      allow read, create: if signedIn();
      allow update, delete: if isCommander();
    }

    match /attendance_logs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if isCommander();
    }

    match /reports/{reportId} {
      allow read, create: if signedIn();
      allow update, delete: if isCommander();
    }

    match /notifications/{notificationId} {
      allow read, create: if signedIn();
      allow update, delete: if isCommander();
    }

    match /system_logs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if isCommander();
    }

match /server_clock/{userId} {
  allow read, write: if request.auth != null && request.auth.uid == userId;
}
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
