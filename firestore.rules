rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDocument() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myRole() {
      return hasUserDocument() ? myUser().data.role : null;
    }

    function mySystemRole() {
      return hasUserDocument() ? myUser().data.systemRole : null;
    }

    function mySystemRoleAccessLevel() {
      return hasUserDocument() &&
        myUser().data.systemRoleAccessLevel is string
          ? myUser().data.systemRoleAccessLevel
          : null;
    }

    function isAdmin() {
      return signedIn() && (
        myRole() == "commander" ||
        mySystemRole() == "admin" ||
        mySystemRole() == "super_admin" ||
        mySystemRoleAccessLevel() == "admin"
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        request.auth.uid == userId || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /attendance/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /attendance_logs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /system_logs/{logId} {
      allow read, create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /server_clock/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }


    match /shifts/{shiftId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }


    match /external_staff/{staffId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /emergency_responses/{responseId} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }


    match /shift_acknowledgements/{ackId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.shiftId is string &&
        request.resource.data.readAt is string &&
        request.resource.data.acknowledgedBy == request.auth.uid;

      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.shiftId == resource.data.shiftId &&
        request.resource.data.acknowledgedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["readAt", "acknowledgedBy"]);

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
