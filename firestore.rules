rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDocument() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function effectiveSystemRole() {
      return !hasUserDocument()
        ? "reporter"
        : myUser().data.systemRole is string
          ? myUser().data.systemRole
          : myUser().data.role == "commander"
            ? "admin"
            : myUser().data.role == "adjutant_officer"
              ? "viewer"
              : "reporter";
    }

    function isSuperAdmin() {
      return hasUserDocument() && effectiveSystemRole() == "super_admin";
    }

    function canManageLinePlanning() {
      return isSuperAdmin() || (
        hasUserDocument() &&
        (
          myUser().data.role == "commander" ||
          hasPermission("line_planning.manage")
        )
      );
    }

    function permissionSettingsExist() {
      return exists(/databases/$(database)/documents/settings/role_permissions);
    }

    function hasPermission(permissionId) {
      return isSuperAdmin() || (
        hasUserDocument() &&
        permissionSettingsExist() &&
        get(/databases/$(database)/documents/settings/role_permissions)
          .data.roleMap is map &&
        get(/databases/$(database)/documents/settings/role_permissions)
          .data.roleMap.get(effectiveSystemRole(), {}) is map &&
        get(/databases/$(database)/documents/settings/role_permissions)
          .data.roleMap.get(effectiveSystemRole(), {}).get(permissionId, false) == true
      );
    }

    function emergencyIsActive() {
      return signedIn() &&
        exists(/databases/$(database)/documents/settings/system_settings) &&
        get(/databases/$(database)/documents/settings/system_settings)
          .data.systemMode == "emergency" &&
        get(/databases/$(database)/documents/settings/system_settings)
          .data.emergencyEvent.active == true;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        request.auth.uid == userId ||
        hasPermission("system_admin.users.manage")
      );
      allow update, delete: if hasPermission("system_admin.users.manage");
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if
        (docId == "role_permissions" && isSuperAdmin()) ||
        (docId == "system_roles" && isSuperAdmin()) ||
        (docId == "attendance_statuses" && hasPermission("system_admin.statuses.manage")) ||
        ((docId == "medical_config" || docId == "medical_role_configs" || docId == "unit_configs") && hasPermission("system_admin.units.manage")) ||
        (docId == "shift_slot_configs" && hasPermission("system_admin.shift_roles.manage")) ||
        (docId == "shift_types" && hasPermission("system_admin.shift_types.manage")) ||
        (docId == "google_sheets" && hasPermission("system_admin.sheets.manage")) ||
        (docId == "system_settings" && (
          hasPermission("system_admin.settings.manage") ||
          (
            hasPermission("emergency.manage") &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["systemMode", "emergencyEvent", "updatedAt", "updatedBy"])
          ) ||
          (
            canManageLinePlanning() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(["linePlanningVisibleToSoldiers", "updatedAt", "updatedBy"])
          )
        ));
    }

    match /attendance/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        hasPermission("reports.manage")
      );
      allow update: if hasPermission("reports.manage") || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdBy == resource.data.createdBy
      );
      allow delete: if hasPermission("reports.delete");
    }

    match /attendance_logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if hasPermission("reports.manage");
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if hasPermission("reports.manage");
      allow delete: if hasPermission("reports.delete");
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
      allow delete: if hasPermission("dashboard.notifications.view");
    }

    match /push_subscriptions/{subscriptionId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.subscriptionId == subscriptionId;
      allow update: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.subscriptionId == resource.data.subscriptionId &&
        request.resource.data.token == resource.data.token;
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        hasPermission("system_admin.users.manage")
      );
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /pwa_installations/{installationId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.installationId == installationId;
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.installationId == resource.data.installationId;
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        hasPermission("system_admin.users.manage")
      );
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /commander_messages/{messageId} {
      allow read: if signedIn();
      allow create, delete: if hasPermission("dashboard.notifications.view");
      allow update: if isSuperAdmin() || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["acknowledgements"])
      );
    }

    match /system_logs/{logId} {
      allow read: if hasPermission("dashboard.system_logs.view") || hasPermission("system_admin.audit.view");
      allow create: if signedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /server_clock/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /shifts/{shiftId} {
      // Reporting soldiers need the published assignments for their personal
      // page even when they do not have access to the full shifts screen.
      allow read: if hasPermission("shifts.view") || (
        signedIn() &&
        hasUserDocument() &&
        myUser().data.role == "soldier"
      );
      allow create, update, delete: if hasPermission("shifts.manage");
    }

    match /line_cycles/{cycleId} {
      allow read: if signedIn();
      allow create, update, delete: if canManageLinePlanning();
    }

    match /line_constraints/{constraintId} {
      allow read: if canManageLinePlanning() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if canManageLinePlanning() || (
        signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        exists(/databases/$(database)/documents/line_cycles/$(request.resource.data.cycleId)) &&
        get(/databases/$(database)/documents/line_cycles/$(request.resource.data.cycleId)).data.status == "open"
      );
      allow update: if canManageLinePlanning() || (
        signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.cycleId == resource.data.cycleId &&
        get(/databases/$(database)/documents/line_cycles/$(resource.data.cycleId)).data.status == "open"
      );
      allow delete: if canManageLinePlanning();
    }

    match /line_presence_plans/{planId} {
      allow read: if canManageLinePlanning() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow create, update, delete: if canManageLinePlanning();
    }

    match /external_staff/{staffId} {
      allow read: if hasPermission("shifts.view") || hasPermission("system_admin.external_staff.manage");
      allow create, update, delete: if hasPermission("system_admin.external_staff.manage");
    }

    match /emergency_responses/{responseId} {
      allow get: if signedIn() &&
        responseId.matches(".*_" + request.auth.uid) &&
        emergencyIsActive();
      allow read: if hasPermission("emergency.view") ||
        hasPermission("emergency.manage") ||
        (emergencyIsActive() && (
          resource.data.authUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          (
            resource.data.personalId is string &&
            myUser().data.personalId == resource.data.personalId
          )
        ));
      allow create: if isSuperAdmin() || (emergencyIsActive() && (
        hasPermission("emergency.manage") ||
        request.resource.data.authUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        (
          request.resource.data.personalId is string &&
          myUser().data.personalId == request.resource.data.personalId
        )
      ));
      allow update: if isSuperAdmin() || (emergencyIsActive() && (
        hasPermission("emergency.manage") ||
        (
          request.resource.data.authUid == resource.data.authUid &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.personalId == resource.data.personalId &&
          (
            resource.data.authUid == request.auth.uid ||
            resource.data.userId == request.auth.uid ||
            (
              resource.data.personalId is string &&
              myUser().data.personalId == resource.data.personalId
            )
          )
        )
      ));
      allow delete: if hasPermission("emergency.manage");
    }

    match /shift_acknowledgements/{ackId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        hasPermission("shifts.manage")
      );

      allow create: if isSuperAdmin() || (signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.shiftId is string &&
        request.resource.data.readAt is string &&
        request.resource.data.acknowledgedBy == request.auth.uid);

      allow update: if isSuperAdmin() || (signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.shiftId == resource.data.shiftId &&
        request.resource.data.acknowledgedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["readAt", "acknowledgedBy"]));

      allow delete: if hasPermission("shifts.manage");
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
