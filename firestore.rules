rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Catch-All Deny Net (The Fortress)
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions & Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCommander() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "commander";
    }

    // 2. User Profiles Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isCommander();
      allow list: if isCommander();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUserUpdate(request.resource.data, resource.data);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'fullName', 'role', 'unit', 'email', 'createdAt']) && 
             data.keys().size() == 6 &&
             data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.unit is string && data.unit.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (data.role == 'soldier' || data.role == 'commander') &&
             data.createdAt == request.time;
    }

    function isValidUserUpdate(data, existingData) {
      return data.userId == existingData.userId &&
             data.createdAt == existingData.createdAt &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.unit is string && data.unit.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             data.role == existingData.role &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'unit', 'email']);
    }

    // 3. Attendance Reports Collection Rules
    match /attendance/{reportId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isCommander());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isCommander());
      allow create: if isSignedIn() && isValidReport(request.resource.data);
      allow update: if isSignedIn() && (
        isCommander() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifiedBy', 'verifiedAt']) &&
        request.resource.data.verifiedBy == request.auth.uid
      );
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reportId', 'userId', 'userName', 'unit', 'status', 'location', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.unit is string && data.unit.size() <= 100 &&
             data.location is string && data.location.size() <= 200 &&
             (data.status == 'base' || data.status == 'home' || data.status == 'field' || data.status == 'sick' || data.status == 'course' || data.status == 'other') &&
             data.timestamp == request.time;
    }
  }
}
